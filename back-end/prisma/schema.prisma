generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  userId              Int                  @id @default(autoincrement()) @map("user_id")
  fullName            String               @map("full_name")
  email               String               @unique
  phone               String?
  passwordHash        String               @map("password_hash")
  role                String
  status              String
  createdAt           DateTime             @default(now()) @map("created_at")
  bookings            Booking[]
  invoices            Invoice[]
  matches             Match[]
  matchParticipants   MatchParticipant[]
  passwordResetTokens PasswordResetToken[]
  reviews             Review[]
  sessions            Session[]
  slotHolds           SlotHold[]

  @@map("users")
}

model Session {
  sessionId    Int       @id @default(autoincrement()) @map("session_id")
  userId       Int       @map("user_id")
  refreshToken String    @map("refresh_token")
  userAgent    String?   @map("user_agent")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  user         User      @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: NoAction, map: "session_user_fk")

  @@index([userId])
  @@index([userId], map: "idx_session_user")
  @@map("sessions")
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  token     String   @map("token")
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@index([userId], map: "idx_password_user")
  @@map("password_reset_tokens")
}

model Field {
  fieldId     Int         @id @default(autoincrement()) @map("field_id")
  name        String
  description String?
  image       String?
  fieldType   FieldType   @map("field_type")
  createdAt   DateTime?   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime?   @default(now()) @map("updated_at") @db.Timestamptz(6)
  fieldSlots  FieldSlot[]
  reviews     Review[]

  @@map("field")
}

model Service {
  serviceId       Int               @id @default(autoincrement()) @map("service_id")
  name            String
  description     String?
  image           String?
  price           Decimal           @db.Decimal(10, 2)
  quantity        Int               @default(0)
  status          ServiceStatus     @default(ACTIVE)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  bookingServices BookingServices[]

  @@map("service")
}

model Match {
  matchId      Int                @id @default(autoincrement()) @map("match_id")
  userId       Int                @map("user_id")
  minAge       Int?               @map("min_age")
  maxAge       Int?               @map("max_age")
  fieldType    FieldType          @map("field_type")
  timeNote     String?            @map("time_note")
  description  String?
  costRule     CostRule           @map("cost_rule")
  status       MatchStatus        @default(OPEN)
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  user         User               @relation(fields: [userId], references: [userId], onDelete: Cascade)
  participants MatchParticipant[]

  @@index([userId])
  @@map("match")
}

model MatchParticipant {
  participantId Int      @id @default(autoincrement()) @map("participant_id")
  userId        Int      @map("user_id")
  matchId       Int      @map("match_id")
  joinedAt      DateTime @default(now()) @map("joined_at")
  match         Match    @relation(fields: [matchId], references: [matchId], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [userId])

  @@unique([matchId, userId])
  @@index([userId])
  @@map("match_participants")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model BookingServices {
  bookingServiceId Int      @id @default(autoincrement()) @map("booking_service_id")
  bookingId        Int      @map("booking_id")
  serviceId        Int      @map("service_id")
  quantity         Int      @default(1)
  price            Decimal  @db.Decimal(10, 2)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  booking          Booking  @relation(fields: [bookingId], references: [bookingId], onDelete: Cascade, onUpdate: NoAction, map: "fk_booking_services_booking")
  service          Service  @relation(fields: [serviceId], references: [serviceId], onUpdate: NoAction, map: "fk_booking_services_service")

  @@index([bookingId], map: "idx_booking_services_booking")
  @@index([serviceId], map: "idx_booking_services_service")
  @@map("booking_services")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Booking {
  bookingId Int @id @default(autoincrement()) @map("booking_id")
  userId    Int @map("user_id")

  status        BookingStatus @default(HOLD)
  type          BookingType   @default(ONE_TIME)
  depositAmount Decimal       @default(0) @map("deposit_amount") @db.Decimal(10, 2)
  totalPrice    Decimal       @map("total_price") @db.Decimal(10, 2)
  paidAmount    Decimal       @default(0) @map("paid_amount") @db.Decimal(10, 2)

  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  cancelledAt  DateTime? @map("cancelled_at") @db.Timestamp(6)
  cancelReason String?   @map("cancel_reason")
  note         String?
  invoiceId    Int?      @map("invoice_id")

  bookingSlots    BookingSlot[]
  bookingServices BookingServices[]
  user            User              @relation(fields: [userId], references: [userId], onDelete: NoAction, onUpdate: NoAction, map: "bookings_user_fk")
  invoice         Invoice?          @relation(fields: [invoiceId], references: [invoiceId])
  review          Review?
  fieldSlot       FieldSlot?        @relation(fields: [fieldSlotSlotId], references: [slotId])
  fieldSlotSlotId Int?

  @@index([userId], map: "idx_booking_user")
  @@map("bookings")
}

model BookingSlot {
  bookingSlotId Int      @id @default(autoincrement()) @map("booking_slot_id")
  bookingId     Int      @map("booking_id")
  slotId        Int      @map("slot_id")
  bookingDate   DateTime @map("booking_date") @db.Date

  // Snapshot giá tại thời điểm đặt — KHÔNG lấy giá hiện tại của FieldSlot khi hiển thị lịch sử,
  // vì giá sân có thể đổi sau này, đơn cũ phải giữ nguyên giá đã tính.
  price Decimal @db.Decimal(10, 2)

  booking   Booking   @relation(fields: [bookingId], references: [bookingId], onDelete: Cascade, map: "booking_slots_booking_fk")
  fieldSlot FieldSlot @relation(fields: [slotId], references: [slotId], onDelete: Cascade, onUpdate: NoAction, map: "booking_slots_slot_fk")

  @@index([bookingId], map: "idx_booking_slot_booking")
  @@index([bookingDate], map: "idx_booking_slot_date")
  @@index([slotId, bookingDate], map: "idx_booking_slot_slot_date")
  @@map("booking_slots")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model FieldSlot {
  slotId       Int           @id @default(autoincrement()) @map("slot_id")
  fieldId      Int           @map("field_id")
  starttime    DateTime      @db.Time(6)
  endtime      DateTime      @db.Time(6)
  price        Decimal       @db.Decimal(10, 2)
  bookings     Booking[]
  field        Field         @relation(fields: [fieldId], references: [fieldId], onDelete: Cascade, onUpdate: NoAction, map: "fk_field")
  slotHolds    SlotHold[]
  slotBlocks   BlockedSlot[]
  bookingSlots BookingSlot[]

  @@index([fieldId], map: "idx_field_slots_field")
  @@index([fieldId], map: "idx_field_slots_field_id")
  @@map("field_slots")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Invoice {
  invoiceId     Int           @id @default(autoincrement()) @map("invoice_id")
  userId        Int           @map("user_id")
  totalAmount   Decimal       @map("total_amount") @db.Decimal(10, 2)
  status        InvoiceStatus @default(PENDING)
  createdAt     DateTime      @default(now()) @map("created_at")
  deposit       Decimal       @default(0) @db.Decimal(10, 2)
  fieldAmount   Decimal       @default(0) @map("field_amount") @db.Decimal(10, 2)
  serviceAmount Decimal       @default(0) @map("service_amount") @db.Decimal(10, 2)
  remainAmount  Decimal       @default(0) @map("remain_amount") @db.Decimal(10, 2)
  paymentMethod String?       @map("payment_method")
  paidAt        DateTime?     @map("paid_at") @db.Timestamp(6)
  bookings      Booking[]
  user          User          @relation(fields: [userId], references: [userId], onDelete: NoAction, onUpdate: NoAction, map: "invoice_user_fk")

  @@map("invoices")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Review {
  reviewId  Int       @id @default(autoincrement()) @map("review_id")
  bookingId Int       @unique @map("booking_id")
  userId    Int       @map("user_id")
  fieldId   Int       @map("field_id")
  rating    Int       @db.SmallInt
  comment   String?
  reply     String?
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime? @default(now()) @map("updated_at") @db.Timestamp(6)
  booking   Booking   @relation(fields: [bookingId], references: [bookingId], onDelete: Cascade, onUpdate: NoAction, map: "fk_review_booking")
  field     Field     @relation(fields: [fieldId], references: [fieldId], onDelete: Cascade, onUpdate: NoAction, map: "fk_review_field")
  user      User      @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: NoAction, map: "fk_review_user")

  @@map("reviews")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model SlotHold {
  holdId      Int       @id @default(autoincrement()) @map("hold_id")
  userId      Int       @map("user_id")
  slotId      Int       @map("slot_id")
  bookingDate DateTime  @map("booking_date") @db.Date
  expiresAt   DateTime  @map("expires_at") @db.Timestamp(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  fieldSlot   FieldSlot @relation(fields: [slotId], references: [slotId], onDelete: Cascade, onUpdate: NoAction, map: "fk_hold_slot")
  user        User      @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: NoAction, map: "fk_hold_user")

  @@unique([slotId, bookingDate], map: "uq_slot_hold_slot_date")
  @@index([expiresAt], map: "idx_slot_hold_expire")
  @@index([slotId], map: "idx_slot_hold_slot")
  @@map("slot_holds")
}

model BlockedSlot {
  blockId     Int       @id @default(autoincrement()) @map("block_id")
  slotId      Int       @map("slot_id")
  bookingDate DateTime  @map("booking_date") @db.Date
  reason      String?   @db.VarChar(255)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @updatedAt @map("updated_at")
  fieldSlot   FieldSlot @relation(fields: [slotId], references: [slotId], onDelete: Cascade)

  @@unique([slotId, bookingDate])
  @@index([bookingDate])
  @@index([slotId])
  @@map("blocked_slots")
}

enum FieldStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

enum FieldType {
  FIVE
  SEVEN
  ELEVEN
}

enum ServiceStatus {
  ACTIVE
  INACTIVE
}

enum CostRule {
  SPLIT
  LOSER_PAYS
  WINNER_PAYS
  NEGOTIATE
}

enum MatchStatus {
  OPEN
  MATCHED
  FINISHED
  CANCELLED
}

enum BookingStatus {
  HOLD
  CONFIRMED
  CANCELLED
}

enum BookingType {
  ONE_TIME
  RECURRING
}

enum InvoiceStatus {
  PENDING
  PAID
}

enum SlotStatus {
  AVAILABLE
  HOLD
  BOOKED
  CLOSED
}
